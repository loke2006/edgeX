# =============================================================================
# EdgeCloudX Environment Configuration
# Copy this file to .env and fill in values
# =============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPICS=traffic-density,ev-telemetry,emergency-alerts,anomaly-events,node-health

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL ---
POSTGRES_USER=edgecloudx
POSTGRES_PASSWORD=edgecloudx_secret
POSTGRES_DB=edgecloudx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edgecloudx:edgecloudx_secret@postgres:5432/edgecloudx

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Service Ports ---
TRAFFIC_SERVICE_PORT=8001
ROUTING_SERVICE_PORT=8002
ANALYTICS_SERVICE_PORT=8003
ALERT_SERVICE_PORT=8004
AUTH_SERVICE_PORT=8005
DASHBOARD_PORT=8000

# --- Edge Node ---
EDGE_NODE_ID=edge-node-01
INTERSECTION_COUNT=16
VEHICLE_DENSITY=medium
EVENT_INTERVAL_MS=1000

# --- Ray ---
RAY_HEAD_ADDRESS=ray-head:6379
RAY_NUM_CPUS=4

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- Federated Learning ---
FL_SERVER_ADDRESS=fl-server:8080
FL_NUM_ROUNDS=10
FL_MIN_CLIENTS=2
